<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ALL APP-LEVEL PERMISSIONS MUST GO HERE -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DinePulse">

        <!-- LoginActivity is now our starting screen -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- All other screens are registered here -->
        <activity android:name=".RegisterActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".GuestMenuActivity" android:exported="false" />
        <activity android:name=".ManagerDashboardActivity" android:exported="false" />
        <activity android:name=".FloorPlanActivity" android:exported="false" />
        <activity android:name=".AnalyticsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CartActivity" />
        <activity android:name=".OrderStatusActivity" />
        <activity android:name=".ManagerReportActivity" />
        <activity android:name=".ReceiptActivity" android:exported="false" />
        <activity android:name=".OrderHistoryActivity" android:exported="false" />
        <activity android:name=".AdminReceiptActivity" android:exported="false" />
        <activity android:name=".QrScannerActivity" android:exported="false" />
        <activity android:name=".GuestHomeActivity" android:exported="false" />
        <activity android:name=".VenueSettingsActivity" android:exported="false" />
        <activity android:name=".VenueProfileActivity" android:exported="false" />
        <activity android:name=".PaymentSelectionActivity" android:exported="false" />
    </application>
</manifest>