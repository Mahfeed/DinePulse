<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="100dp">

            <!-- Full Bleed Cover Photo -->
            <ImageView
                android:id="@+id/ivCoverPhoto"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:background="#E5E7EB"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:cardCornerRadius="50dp"
                app:cardElevation="6dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="4dp"
                app:layout_constraintTop_toBottomOf="@id/ivCoverPhoto"
                app:layout_constraintBottom_toBottomOf="@id/ivCoverPhoto"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivVenueLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvVenueProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="#111827"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/cardLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvVenueBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:text="World-famous flavors..."
                android:textColor="#374151"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textAlignment="center"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvVenueProfileName" />

            <TextView
                android:id="@+id/tvTableBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Seated at TABLE 08"
                android:textColor="#065F46"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/rounded_edittext_bg"
                app:backgroundTint="#D1FAE5"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tvVenueBio"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvRatingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ 4.8 (1,204 Reviews)"
                android:textColor="#374151"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvTableBadge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- PROMO CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPromo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB"
                app:layout_constraintTop_toBottomOf="@id/tvRatingBadge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvPromoHeadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎁 Promotions Available"
                        android:textColor="#111827"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvPromoSubtext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✨ HAPPY HOUR SPECIAL • Use code LUXURY20"
                        android:textColor="#E5E7EB"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:background="@drawable/rounded_edittext_bg"
                        android:backgroundTint="#475569"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- UTILITY GRID: Wi-Fi & Hours Side-by-Side -->
            <LinearLayout
                android:id="@+id/layoutUtilityGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@id/cardPromo">

                <!-- Wi-Fi Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWifi"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E7EB">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📶 Free Wi-Fi" android:textColor="#111827" android:textStyle="bold" android:textSize="14sp" android:layout_marginBottom="8dp"/>
                        <TextView android:id="@+id/tvWifiDetails" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Network: \nPassword: " android:textColor="#4B5563" android:textSize="13sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Hours Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHours"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E7EB">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🕒 Today's Operating Hours" android:textColor="#111827" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="8dp"/>
                        <TextView android:id="@+id/tvOperatingHours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11:00 AM to 9:00 PM" android:textColor="#4B5563" android:textSize="13sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Trending Carousel -->
            <TextView
                android:id="@+id/tvTrendingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chef's Specials"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginStart="20dp"
                app:layout_constraintTop_toBottomOf="@id/layoutUtilityGrid"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTrending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/tvTrendingTitle" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExploreMenu"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:text="Explore Menu &amp; Order →"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#0F172A"
        app:cornerRadius="12dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>