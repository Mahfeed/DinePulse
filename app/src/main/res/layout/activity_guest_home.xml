<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Guest Logout Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuestLogout"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Logout"
        android:textColor="#EF4444"
        app:strokeColor="#EF4444"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnScanTableQR">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to DinePulse"
            android:textColor="#111827"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please scan the QR code on your table to view the menu and place your order."
            android:textColor="#6B7280"
            android:textSize="16sp"
            android:textAlignment="center"
            android:paddingHorizontal="32dp"/>

        <View
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/rounded_edittext_bg"
            android:backgroundTint="#E5E7EB"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanTableQR"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:text="Scan Table QR"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#D4AF37"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnManualEmulatorEntry" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnManualEmulatorEntry"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:text="Enter Table Code Manually"
        android:textSize="14sp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>