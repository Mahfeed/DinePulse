<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Top Bar -->
    <TextView
        android:id="@+id/tvCartTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Order"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:layout_marginTop="24dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Dine-in / Takeout Toggle -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleOrderType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/btnDineIn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCartTitle">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDineIn"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dine-in" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTakeout"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Takeout" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Empty Cart State Message -->
    <TextView
        android:id="@+id/tvEmptyCartMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your cart is currently empty.\nAdd dishes from the menu to get started."
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="#6B7280"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toggleOrderType"
        app:layout_constraintBottom_toTopOf="@id/cardCheckout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cart Items RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/toggleOrderType"
        app:layout_constraintBottom_toTopOf="@id/cardCheckout" />

    <!-- Luxury Checkout Bottom Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCheckout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="16dp"
        app:cardCornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Customer Notes for Chef -->
            <EditText
                android:id="@+id/etCartNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Add notes for the chef (e.g., Extra spicy, allergy warning)"
                android:textColorHint="#9CA3AF"
                android:textColor="#111827"
                android:textSize="14sp"
                android:background="@drawable/rounded_edittext_bg"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/etCouponCode" />

            <!-- Coupon Code Section -->
            <EditText
                android:id="@+id/etCouponCode"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:hint="Enter VIP Code (LUXURY20)"
                android:textColorHint="#757575"
                android:textColor="#111827"
                android:textSize="14sp"
                android:inputType="textCapCharacters"
                android:background="@drawable/rounded_edittext_bg"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnApplyCoupon"
                app:layout_constraintTop_toBottomOf="@id/etCartNotes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyCoupon"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Apply"
                app:cornerRadius="8dp"
                app:backgroundTint="#111827"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/etCouponCode"
                app:layout_constraintBottom_toBottomOf="@id/etCouponCode" />

            <!-- Total Price -->
            <TextView
                android:id="@+id/tvTotalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Payable"
                android:textSize="18sp"
                android:textColor="#6B7280"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etCouponCode" />

            <TextView
                android:id="@+id/tvTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="৳0.00"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#111827"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvTotalLabel"
                app:layout_constraintBottom_toBottomOf="@id/tvTotalLabel"/>

            <!-- Secure Payment / Checkout Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:text="Proceed to Payment"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#006AFF"
                app:cornerRadius="12dp"
                app:layout_constraintTop_toBottomOf="@id/tvTotalLabel" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>