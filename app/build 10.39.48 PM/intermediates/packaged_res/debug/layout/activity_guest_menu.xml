<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <!-- Top Luxury Header -->
    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Obsidian Lounge"
        android:textColor="#D4AF37"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHeaderSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvHeaderTitle"
        android:text="EXECUTIVE GUEST MENU"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <!-- Dynamic Menu List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvHeaderSubtitle" />

    <!-- "Call Server" Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCallServer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:contentDescription="Call Server"
        app:backgroundTint="#D4AF37"
        app:tint="#000000"
        android:src="@android:drawable/ic_dialog_email" />

</RelativeLayout>