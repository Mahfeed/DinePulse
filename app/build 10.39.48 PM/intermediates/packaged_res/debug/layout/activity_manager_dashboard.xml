<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:padding="16dp">

    <!-- Executive Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📊 Executive Inventory"
        android:textColor="#D4AF37"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Button to launch Live Floor Plan -->
    <Button
        android:id="@+id/btnFloorPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗺️ View Live Floor Plan"
        android:textColor="#000000"
        android:backgroundTint="#D4AF37"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Dynamic Inventory Toggle List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewStock"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>